  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xml:lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\"><p class=\"res-header-id\"><b>Generated Narrative: ImplementationGuide fi.mikaelrinnetmaki.ips</b></p><a name=\"fi.mikaelrinnetmaki.ips\"> </a><a name=\"hcfi.mikaelrinnetmaki.ips\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Language: en</p></div><h2>MikaelsIPS</h2><p>The official URL for this implementation guide is: </p><pre>https://mikaelrinnetmaki.fi/ips/ig/ImplementationGuide/fi.mikaelrinnetmaki.ips</pre><div><p>This document describes Sensotrend's implementation of the <a href=\"https://hl7.org/fhir/uv/ips/\">HL7 FHIR IPS</a> format of the <a href=\"https://international-patient-summary.net/\">International Patient Summary (IPS)</a> specification both as a client app and as a FHIR server. It also includes and extensive example patient summary for Mikael Rinnetmäki, the author and the patient.</p>\n</div></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:url [ fhir:v "https://mikaelrinnetmaki.fi/ips/ig/ImplementationGuide/fi.mikaelrinnetmaki.ips"^^xsd:anyURI] ; # 
